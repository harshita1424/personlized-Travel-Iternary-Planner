# ========================================================
# Personalized Travel Itinerary Planner - Environment Variables
# ========================================================

# Application Configuration
PROJECT_NAME="Personalized Travel Itinerary Planner"
PORT=8000
ENVIRONMENT=development
SECRET_KEY=super-secret-travel-planner-key-change-in-prod-2026

# Supabase PostgreSQL Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Generative AI Configuration
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-google-gemini-api-key

# Frontend URL (For CORS in production)
FRONTEND_URL=https://your-travel-planner.vercel.app
